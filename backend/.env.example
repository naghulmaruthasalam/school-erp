# --- App ---
APP_NAME="Cogniitec AI School ERP"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
# Must be a publicly reachable URL in production — PayU redirects the user's
# browser back here (to /api/v1/payments/payu/callback) after checkout.
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cogniitec_school_erp

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AWS S3 (file/image storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=cogniitec-school-erp-files
S3_KEY_PREFIX=
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# --- Google Vertex AI (Gemini 2.5 Flash Lite) ---
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL_NAME=gemini-2.5-flash-lite
# Gemini Developer API key: powers the Copilot (chat, quiz, question papers, answer-sheet grading).
# Get one at https://aistudio.google.com/apikey . Without it the Copilot shows a clear "not set up" message.
GEMINI_API_KEY=

# --- PayU (India) payment gateway ---
# Test/sandbox base URL below; switch to https://secure.payu.in/_payment (and
# postservice to https://info.payu.in/...) for production.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_BASE_URL=https://test.payu.in/_payment
PAYU_POSTSERVICE_URL=https://test.payu.in/merchant/postservice.php?form=2

# OAuth client credentials for PayU's separate OAuth-secured API families
# (e.g. Payouts) — not used by the checkout or refund flow in this app, but
# kept configurable in case a future integration needs them.
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_OAUTH_TOKEN_URL=https://uat-accounts.payu.in/oauth/token

# --- Super admin bootstrap (used by scripts/create_super_admin.py) ---
SUPER_ADMIN_EMAIL=superadmin@cogniitec.com
SUPER_ADMIN_PASSWORD=change-me

# --- Curriculum source (link to the syllabus JSON/CSV/ZIP; set per school from Syllabus -> Connect source) ---
# CURRICULUM_FETCH_MAX_MB=50
# CURRICULUM_FETCH_TIMEOUT_SECONDS=30
# Local development only: allow http:// and private addresses
# CURRICULUM_ALLOW_PRIVATE_URLS=false

# --- Copilot (study / teaching assistant) ---
# Roles that get the Copilot
COPILOT_ENABLED_ROLES=STUDENT,PARENT,TEACHER
# gemini (default, uses GEMINI_API_KEY) or openai (uses OPENAI_API_KEY)
COPILOT_LLM_PROVIDER=gemini
# OPENAI_API_KEY=
# COPILOT_MESSAGES_PER_MINUTE=20
# PDF export (question papers, worksheets, lesson plans, grading reports) needs Chromium: run
#   playwright install chromium
# or point this at an existing Chrome/Chromium/Edge executable, e.g. on Windows:
# COPILOT_CHROMIUM_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
